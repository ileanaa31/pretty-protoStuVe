#set heading(
  numbering: (..nums) => {
    let numbers = nums.pos()

    if (numbers.len() == 1) {
      numbering("§ 1 ", numbers.first())
    }
  },
)

#set page(
  numbering: "1"
)

#set enum(
  full: true,
  numbering: (..nums) => {
    let numbers = nums.pos()

    if (numbers.len() == 1) {
      numbering("(1)", numbers.first())
    } else if(numbers.len() == 2) {
      numbering("1.", numbers.last())
    }
  },
)

